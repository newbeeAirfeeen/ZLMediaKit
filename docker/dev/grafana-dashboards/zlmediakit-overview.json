{
  "title": "ZLMediaKit Overview",
  "uid": "zlm-overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Uptime (s)",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "zlm_uptime_seconds", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "RSS (MB)",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "zlm_memory_rss_bytes / 1024 / 1024", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Open FDs",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "zlm_open_files_total", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Build",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 4 },
      "targets": [
        { "expr": "zlm_build_info", "refId": "A", "legendFormat": "{{version}} / {{branch}} / {{commit}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU usage (%)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "zlm_cpu_usage_percent", "refId": "A" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Thread load (%)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "zlm_thread_load_percent", "refId": "A", "legendFormat": "{{type}} #{{thread_id}}" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Streams by schema",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "zlm_stream_total", "refId": "A", "legendFormat": "{{schema}}" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Sessions by type",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "zlm_session_total", "refId": "A", "legendFormat": "{{type}}" }
      ]
    }
  ]
}
